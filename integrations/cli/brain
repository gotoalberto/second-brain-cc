#!/usr/bin/env python3
"""brain — Brain from any shell: an agent that can run a command, a script, or you.

  brain recall <terms...>            what the vault knows, rendered as Brain's prompt hook injects it
  brain search <terms...> [--all] [--limit N] [--type T] [--project P] [--full]
  brain recent [N]
  brain get <vault/relative/path.md>
  brain new <path> --title "T" [--type note] [--tag t] [--project p] [--area a]   (body on stdin)
  brain append <path>                                                             (text on stdin)
  brain index [--full]
  brain sync
  brain status
  brain session-start                 the startup context a Claude Code session gets
  brain session-end                   release this session's claims, mark the vault dirty
  brain hook <event-id> [--payload JSON]
                                      run any Brain event's hook handler the way Claude Code runs it:
                                      stdin is a JSON object with session_id, cwd, source ("cli") and
                                      hook_event_name, plus the --payload fields; the exit code is the
                                      handler's (2 blocks). Verify the exact JSON a handler reads before
                                      wiring another agent's hook to it: 90-Meta/HOOKS-WITHOUT-CLAUDE.md
  brain mcp [--vault DIR]             run the MCP server on stdio

Every command runs under one session id: BRAIN_SESSION_ID when the caller exported it,
else `cli-<pid>` for this invocation's whole process tree, so notes it writes are credited
to that session and not to "system".

The vault is the repository this script lives in; BRAIN_VAULT overrides it.
Adapted from the public second-brain-cc CLI. There is no secret command: credentials stay
in the kdbx, reached with _bin/kp.py by a person, not through this wrapper.
"""
import json
import os
import shlex
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
VAULT = os.path.abspath(os.environ.get("BRAIN_VAULT") or os.path.dirname(os.path.dirname(HERE)))
BIN = os.path.join(VAULT, "_bin")
PY = sys.executable or "/usr/bin/python3"


def die(msg, code=1):
    sys.stderr.write("brain: " + msg + "\n")
    sys.exit(code)


def script(name):
    p = os.path.join(BIN, name)
    if not os.path.isfile(p):
        die("cannot find %s (is BRAIN_VAULT correct? got %s)" % (name, VAULT))
    return p


def session_env():
    env = dict(os.environ)
    env["BRAIN_VAULT"] = VAULT
    if not (env.get("BRAIN_SESSION_ID") or "").strip():
        env["BRAIN_SESSION_ID"] = "cli-%d" % os.getpid()
    return env


def exec_script(name, args):
    """Replace this process with the target script, inheriting stdio and the session id."""
    os.execve(PY, [PY, script(name)] + args, session_env())


def with_sid(args, env):
    return args if "--sid" in args else args + ["--sid", env["BRAIN_SESSION_ID"]]


def run_script(argv, payload, env):
    """One handler, run with the vault as cwd and the hook JSON object on stdin."""
    return subprocess.run([PY] + argv, input=json.dumps(payload), env=env, cwd=VAULT, capture_output=True, text=True)


def run_hook(name):
    env = session_env()
    payload = {"session_id": env["BRAIN_SESSION_ID"], "cwd": os.getcwd(), "source": "cli"}
    return run_script([script(name)], payload, env), env


def load_events():
    """The vault's 90-Meta/events.json, validated by events_core.domain."""
    path = os.path.join(VAULT, "90-Meta", "events.json")
    if BIN not in sys.path:
        sys.path.insert(0, BIN)
    from events_core import domain as ED
    try:
        with open(path, encoding="utf-8") as fh:
            return ED.load_registry(fh.read())
    except (OSError, ED.RegistryError) as exc:
        die("cannot read the event registry %s: %s" % (path, exc))


def _describe(trigger):
    spec = trigger.spec
    what = spec.get("command") or spec.get("action") or spec.get("label") or spec.get("tool") or spec.get("hook") or ""
    return "%s %s" % (trigger.kind, what)


def cmd_hook(rest):
    """brain hook <event-id> [--payload JSON]: the event's claude-hook commands, in registry order.

    The same generalisation session-start and session-end already use (run_hook), for every
    event: the registry says which script and arguments, this supplies the stdin JSON.
    """
    if not rest or rest[0].startswith("-"):
        die("hook needs an event id (see 90-Meta/HOOKS-WITHOUT-CLAUDE.md)", 2)
    event_id, args, extra = rest[0], rest[1:], {}
    if args:
        if args[0] != "--payload" or len(args) != 2:
            die("usage: brain hook <event-id> [--payload JSON]", 2)
        try:
            extra = json.loads(args[1])
        except ValueError:
            extra = None
        if not isinstance(extra, dict):
            die("--payload must be a JSON object", 2)
    registry = load_events()
    try:
        event = registry.event(event_id)
    except KeyError:
        die("unknown event: %s (known: %s)" % (event_id, ", ".join(e.id for e in registry.events)), 2)
    hooks = [t for t in event.triggers if t.kind == "claude-hook"]
    if not hooks:
        die("event %s has no hook command to run; it is triggered by: %s"
            % (event_id, ", ".join(_describe(t) for t in event.triggers) or "nothing"), 2)
    env = session_env()
    for trig in hooks:
        tokens = shlex.split(trig.spec["command"])
        payload = {"session_id": env["BRAIN_SESSION_ID"], "cwd": os.getcwd(), "source": "cli",
                   "hook_event_name": trig.spec["event"]}
        payload.update(extra)
        p = run_script([script(tokens[0])] + tokens[1:], payload, env)
        sys.stdout.write(p.stdout)
        sys.stderr.write(p.stderr)
        if p.returncode != 0:
            return p.returncode
    return 0


def cmd_recall(terms):
    if not terms:
        die("recall needs search terms", 2)
    os.environ["BRAIN_VAULT"] = VAULT                 # brainlib reads it once, at import
    sys.path.insert(0, BIN)
    import brainlib as B
    import retrieve_core as R
    con = B.db()
    try:
        block = R.search_and_render(con, " ".join(terms))
    finally:
        con.close()
    print(block if block else
          "Nothing in the vault clears the relevance bar for that. Try `brain search <terms>` for a plain list.")


def cmd_get(rest):
    if not rest:
        die("get needs a vault-relative path", 2)
    real = os.path.realpath(os.path.join(VAULT, rest[0].lstrip("/")))
    if not real.startswith(os.path.realpath(VAULT) + os.sep):
        die("path escapes the vault")
    if not os.path.isfile(real):
        die("no such note: %s" % rest[0])
    with open(real, encoding="utf-8", errors="replace") as f:
        sys.stdout.write(f.read())


def cmd_session_start():
    p, _ = run_hook("compass.py")
    try:
        data = json.loads(p.stdout) if p.stdout.strip() else {}
    except ValueError:
        data = {}
    context = (data.get("hookSpecificOutput") or {}).get("additionalContext")
    if context is None:
        sys.stdout.write(p.stdout)
        sys.stderr.write(p.stderr)
        return p.returncode
    print(context)
    if data.get("systemMessage"):
        print("\n" + data["systemMessage"])
    return 0


def cmd_session_end():
    p, env = run_hook("session_end.py")
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
        return p.returncode
    print("session %s ended" % env["BRAIN_SESSION_ID"])
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in ("recall", "q"):
        cmd_recall(rest)
        return 0
    if cmd == "search":
        if not rest:
            die("search needs terms", 2)
        exec_script("query.py", rest)
    if cmd == "recent":
        exec_script("query.py", ["--recent", rest[0] if rest and rest[0].isdigit() else "10"])
    if cmd in ("get", "cat", "show"):
        cmd_get(rest)
        return 0
    if cmd == "new":
        if not rest:
            die("new needs a path and --title", 2)
        exec_script("vw.py", with_sid(["new"] + rest, session_env()))
    if cmd == "append":
        if not rest:
            die("append needs a path (text on stdin)", 2)
        exec_script("vw.py", with_sid(["append"] + rest, session_env()))
    if cmd in ("index", "reindex"):
        exec_script("index_vault.py", rest)
    if cmd == "sync":
        exec_script("vault_sync.py", rest)
    if cmd in ("status", "doctor", "health"):
        exec_script("doctor.py", rest)
    if cmd == "session-start":
        return cmd_session_start()
    if cmd == "session-end":
        return cmd_session_end()
    if cmd == "hook":
        return cmd_hook(rest)
    if cmd == "mcp":
        server = os.path.join(VAULT, "integrations", "mcp", "server.py")
        if not os.path.isfile(server):
            server = os.path.join(os.path.dirname(HERE), "mcp", "server.py")
        if not os.path.isfile(server):
            die("MCP server not found at %s" % server)
        os.execve(PY, [PY, server] + rest, session_env())
    die("unknown command: %s (try `brain help`)" % cmd, 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
