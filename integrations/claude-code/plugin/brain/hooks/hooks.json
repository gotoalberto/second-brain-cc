{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/compass.py",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/skills_index.py",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/retrieve.py",
            "timeout": 8,
            "statusMessage": "Querying the vault..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/gate_write.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/vault_ledger.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/protocol_guard.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/log_subagent.py",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/gate_memory.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/style_gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/vault_sync.py --hook",
            "statusMessage": "Syncing the vault...",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/session_end.py",
            "async": true
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/brain-origin/Brain/_bin/seed_worktree.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}