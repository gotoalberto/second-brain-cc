      "Bash(git fetch *)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(bun run *)",
      "Bash(python3 __VAULT__/_bin/query.py *)",
      "Bash(python3 __VAULT__/_bin/retrieve.py *)",
      "Bash(python3 __VAULT__/_bin/vw.py *)",
      "Bash(python3 __VAULT__/_bin/claim.py *)",
      "Bash(python3 __VAULT__/_bin/doctor.py*)",
      "Bash(python3 __VAULT__/_bin/guardian.py status*)",
      "Bash(python3 __VAULT__/_bin/kp.py status*)",
      "Bash(python3 __VAULT__/integrations/first-run/first_run.py status*)",
      "Read(__VAULT__/**)"
    ]
  },
  "skipWorkflowUsageWarning": true
}
