# Cron fallback where there are no systemd user units: run the vault's periodic tasks.
# integrations/first-run installs this line into Brain's block of the crontab when the user
# accepts it. /home/brain-origin/Brain is rendered; the job logs under the Brain state directory itself.
*/10 * * * * BRAIN_JOB_LABEL=second-brain-tasks /bin/sh /home/brain-origin/Brain/_bin/pywrap.sh /home/brain-origin/Brain/_bin/tasks.py >/dev/null 2>&1
