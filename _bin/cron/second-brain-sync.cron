# Cron fallback where there are no systemd user units: commit and push the vault.
# integrations/first-run installs this line into Brain's block of the crontab when the user
# accepts it. /home/brain-origin/Brain is rendered; the job logs under the Brain state directory itself.
*/10 * * * * BRAIN_JOB_LABEL=second-brain-sync /bin/sh /home/brain-origin/Brain/_bin/pywrap.sh /home/brain-origin/Brain/_bin/vault_sync.py >/dev/null 2>&1
