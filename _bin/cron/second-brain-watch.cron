# Cron fallback where there are no systemd user units: watch the vault's files for events.
# integrations/first-run installs this line into Brain's block of the crontab when the user
# accepts it. /home/brain-origin/Brain is rendered; the job logs under the Brain state directory itself.
*/1 * * * * BRAIN_JOB_LABEL=second-brain-watch /bin/sh /home/brain-origin/Brain/_bin/pywrap.sh /home/brain-origin/Brain/_bin/brain_watch.py tick >/dev/null 2>&1
