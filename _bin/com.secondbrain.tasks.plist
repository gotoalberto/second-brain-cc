<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.secondbrain.tasks</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VAULT__/_bin/pywrap.sh</string>
    <string>__VAULT__/_bin/tasks.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a minimal PATH: without this, any Homebrew binary fails -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>WorkingDirectory</key><string>__VAULT__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Application Support/brain/logs/tasks/_launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Application Support/brain/logs/tasks/_launchd.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
