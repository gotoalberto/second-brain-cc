# Generated template: integrations/first-run installs it into ~/.config/systemd/user when
# the user accepts it; guardian.py keeps it in step. /home/brain-origin/Brain and /home/brain-origin are rendered.
[Unit]
Description=Second Brain: watch the vault's files for events

[Service]
Type=oneshot
WorkingDirectory=/home/brain-origin/Brain
Environment=BRAIN_JOB_LABEL=second-brain-watch
ExecStart=/bin/sh /home/brain-origin/Brain/_bin/pywrap.sh /home/brain-origin/Brain/_bin/brain_watch.py tick
